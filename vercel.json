{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/fpl/(.*)",
      "destination": "https://fantasy.premierleague.com/api/$1"
    },
    {
      "source": "/api/odds/(.*)",
      "destination": "https://api.the-odds-api.com/v4/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
